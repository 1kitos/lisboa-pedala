[importlinter]
root_package = lisboa_pedala
root_packages =
    lisboa_pedala
    gateway

[importlinter:contract:desbloqueio]
name = desbloqueio so importa de viagens, disponibilidade, shared
type = forbidden
source_modules =
    lisboa_pedala.desbloqueio
forbidden_modules =
    lisboa_pedala.tarifario
    lisboa_pedala.faturacao
    lisboa_pedala.pagamentos
    lisboa_pedala.manutencao
    lisboa_pedala.redistribuicao
    lisboa_pedala.relatorios
    gateway
allow_indirect_imports = True

